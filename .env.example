# Client-safe values. Expo embeds EXPO_PUBLIC_* values in the app bundle.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Required by native clients outside an Expo development session. Use an absolute HTTPS URL.
EXPO_PUBLIC_API_URL=

# Optional. Public Sentry DSN for crash reports. Leave blank to disable.
EXPO_PUBLIC_SENTRY_DSN=

# Optional EAS/build-only values for native crash symbols. Do not put these in the app bundle as EXPO_PUBLIC_*.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Server-only values. Configure these in the API deployment environment only.
# Never prefix service-role, OpenAI, Resend, or moderation keys with EXPO_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
MODERATION_NOTIFY_EMAIL=
